# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/heliopolis"

# ── Authentification JWT ──────────────────────────────────────────────────────
# Minimum 32 caractères — générer avec : openssl rand -hex 32
JWT_SECRET="changeme_au_moins_32_caracteres_obligatoire"

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=4002
NODE_ENV=development
# URL(s) du frontend autorisées pour CORS (séparées par des virgules)
FRONTEND_URLS=http://localhost:3000

# ── Redis (WebSocket adapter + cache) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stockage Cloudflare R2 (optionnel en développement) ──────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Notifications Push (Web Push / VAPID) ────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@exemple.com

# ── IA vectorielle (optionnel) ────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_DIR=logs
